{
  "version": 2,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "saulspodship.com"
        }
      ],
      "destination": "https://www.saulspodship.com/:path*",
      "permanent": true
    },
    {
      "source": "/music-archive/christians-of-pakistan-music-directory",
      "destination": "/Pakistanisingersarchive",
      "permanent": true
    },
    {
      "source": "/music-archive/pakistani-christian-gospel-singers-group",
      "destination": "/Pakistanisingersarchive",
      "permanent": true
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "api/**,firebase-applet-config.json,public/singers.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?originalPath=/api/$1"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/",
      "destination": "/about.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/faq/",
      "destination": "/faq.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:name-:hash.:ext(js|css|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:file(chrome|site-header|seo-aeo|companion|maps-atlas|prophecy-lens|sp-i18n).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:dir(images|icons)/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/((?!assets/|images/|icons/|.*\\.[A-Za-z0-9]+$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/i18n/:lang.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ]
}
